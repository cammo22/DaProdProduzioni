{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DaProdProduzioni",
  "version": "0.6.0",
  "identifier": "com.daprodproduzioni.avatar",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DaProdProduzioni",
        "width": 210,
        "height": 266,
        "x": 60,
        "y": 300,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": false,
        "dragDropEnabled": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "/run/media/**", "/media/**", "/mnt/**", "/tmp/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  }
}
